[
  {
    "stepTitle": "江苏移动 IPTV 服务设置",
    "items": [
      {
        "type": "tips",
        "helpText": "本应用从江苏移动 OTT 接口自动获取频道表与节目单。请确认本机处于江苏移动宽带网络下，否则直播源无法播放（节目单仍可生成）。"
      },
      {
        "type": "text",
        "field": "wizard_port",
        "label": "服务端口",
        "initValue": "18123",
        "rules": [
          {
            "required": true,
            "message": "请填写服务端口"
          },
          {
            "pattern": "^[0-9]{2,5}$",
            "message": "端口只能是数字"
          }
        ]
      },
      {
        "type": "select",
        "field": "wizard_district",
        "label": "地市（决定额外包含哪些本地台）",
        "initValue": "all",
        "options": [
          {
            "label": "全江苏（13 地市全量，推荐）",
            "value": "all"
          },
          {
            "label": "南京",
            "value": "320100"
          },
          {
            "label": "无锡",
            "value": "320200"
          },
          {
            "label": "徐州",
            "value": "320300"
          },
          {
            "label": "常州",
            "value": "320400"
          },
          {
            "label": "苏州",
            "value": "320500"
          },
          {
            "label": "南通",
            "value": "320600"
          },
          {
            "label": "连云港",
            "value": "320700"
          },
          {
            "label": "淮安",
            "value": "320800"
          },
          {
            "label": "盐城",
            "value": "320900"
          },
          {
            "label": "扬州",
            "value": "321000"
          },
          {
            "label": "镇江",
            "value": "321100"
          },
          {
            "label": "泰州",
            "value": "321200"
          },
          {
            "label": "宿迁",
            "value": "321300"
          }
        ]
      },
      {
        "type": "text",
        "field": "wizard_update_at",
        "label": "每天自动更新时间（HH:MM）",
        "initValue": "03:30",
        "rules": [
          {
            "pattern": "^([01]?[0-9]|2[0-3]):[0-5][0-9]$",
            "message": "格式必须是 HH:MM，例如 03:30"
          }
        ]
      },
      {
        "type": "switch",
        "field": "wizard_schedule_enabled",
        "label": "启用定时自动更新",
        "initValue": "true"
      },
      {
        "type": "tips",
        "helpText": "关闭后不再自动更新，可随时在本应用「定时更新」页或应用中心手动更新。定时时间也可在「定时更新」页直接修改。"
      },
      {
        "type": "switch",
        "field": "wizard_epg_enable",
        "label": "拉取节目单（EPG，下次成功更新后生效）",
        "initValue": "true"
      },
      {
        "type": "text",
        "field": "wizard_days",
        "label": "节目单往后抓几天",
        "initValue": "3",
        "rules": [
          {
            "pattern": "^[0-9]+$",
            "message": "只能是数字"
          }
        ]
      },
      {
        "type": "text",
        "field": "wizard_history_days",
        "label": "节目单往前抓几天（回看用）",
        "initValue": "7",
        "rules": [
          {
            "pattern": "^[0-9]+$",
            "message": "只能是数字"
          }
        ]
      },
      {
        "type": "text",
        "field": "wizard_backup_days",
        "label": "回看可追溯天数",
        "initValue": "7",
        "rules": [
          {
            "pattern": "^[0-9]+$",
            "message": "只能是数字"
          }
        ]
      },
      {
        "type": "switch",
        "field": "wizard_localize_logo",
        "label": "台标本地化（抓回 NAS，避免外网掉图）",
        "initValue": "true"
      },
      {
        "type": "select",
        "field": "wizard_output_mode",
        "label": "输出文件模式",
        "initValue": "minimal",
        "options": [
          {
            "label": "精简（只出 iptv.m3u8 / epg.xml / tvbox.json）",
            "value": "minimal"
          },
          {
            "label": "完整（额外输出 CSV 清单、多种播放器格式）",
            "value": "full"
          }
        ]
      }
    ]
  }
]