#!/bin/bash
# 配置变更前校验：在真正应用前先验证表单值是否可用
set -u
PY="$(command -v python3 2>/dev/null)"
if [ -z "$PY" ]; then
    echo "系统未找到 python3。" > "${TRIM_TEMP_LOGFILE:-/dev/stderr}"
    exit 1
fi

# 端口冲突预检（仅当表单给了端口且端口被别的进程占用时提示）
P="${wizard_port:-}"
if [ -n "$P" ] && [ "$P" -ge 1024 ] 2>/dev/null && [ "$P" -le 65535 ] 2>/dev/null; then
    if command -v ss >/dev/null 2>&1 && ss -lnt 2>/dev/null | grep -q ":$P "; then
        # 如果是本应用自己占用则放行
        if [ -f "${TRIM_PKGVAR}/app.pid" ] && kill -0 "$(cat "${TRIM_PKGVAR}/app.pid" 2>/dev/null)" 2>/dev/null; then
            exit 0
        fi
        echo "端口 $P 已被其他程序占用，请更换端口。" > "${TRIM_TEMP_LOGFILE:-/dev/stderr}"
        exit 1
    fi
fi
exit 0